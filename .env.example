# Digital Learning Review — environment template
#
# Copy to `.env` and fill in. The container reads ALL configuration from this
# file (docker-compose.yml injects it via env_file); nothing is read from a
# credentials file on disk.
#
# THIS FILE CONTAINS NO VALUES AND MUST NEVER CONTAIN ANY. `.env` itself is
# gitignored, and this repository is public.
#
# Where to obtain each value is noted below, because during a rebuild the
# original `.env` may not be available. See deploy/RESTORE.md.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite location inside the container. Leave unset to use the default, which
# is where the /opt/shared-audit-data host volume is mounted.
DB_PATH=/app/data/audit_cache.db

# Forces container path resolution in database.py::get_database_path().
AM_I_DOCKER=true

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Unset/unrecognised = SQLiteAuthProvider (default).
# Other values: ENV | AD | ACTIVE_DIRECTORY | GOOGLE | GOOGLE_OAUTH
AUTH_PROVIDER=

# --- Google sign-in (only needed when AUTH_PROVIDER=GOOGLE) ----------------
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs.
# Reissuable: create a new web client if the original is lost.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorised redirect URI on the OAuth client.
OAUTH_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Google service account (Sheets ETL)
# ---------------------------------------------------------------------------
# Reassembled into credentials by data_manager.py::get_gspread_client().
#
# RECOVERY: if these are lost, generate a NEW key for the existing service
# account in Google Cloud Console > IAM & Admin > Service Accounts > Keys, then
# transcribe the downloaded JSON into the fields below. The service account
# must retain Viewer access on every spreadsheet listed further down.
GOOGLE_TYPE=service_account
GOOGLE_PROJECT_ID=
GOOGLE_PRIVATE_KEY_ID=
# Keep the literal \n escape sequences; they are expanded at load time.
GOOGLE_PRIVATE_KEY=
GOOGLE_CLIENT_EMAIL=
# The service account's own client id — a DIFFERENT credential from the OAuth
# client id above. Do not reuse one for the other.
GOOGLE_SA_CLIENT_ID=
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_CLIENT_X509_CERT_URL=
GOOGLE_UNIVERSE_DOMAIN=googleapis.com

# Deprecated: previously read as BOTH the OAuth client id and the service
# account client id. Set the two variables above instead. Retained only as a
# fallback so an old .env keeps working.
# GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Upstream spreadsheets (Sheets -> SQLite ETL)
# ---------------------------------------------------------------------------
# The id is the long string in the sheet URL between /d/ and /edit.
# These are the hardest values to reconstruct from scratch — if you have no
# backup of .env, you must locate each sheet in Drive by hand.
# MAIN_SPREADSHEET_ID was retired in v1.15.0. The 25/26 baseline it fed
# (main_vle_audit_aut/_spr) is now a frozen snapshot held only in SQLite, so
# there is no sheet left to point at. Do not reintroduce it.
ASSESSMENT_SPREADSHEET_ID=
CHECKLIST_SPREADSHEET_ID=
USERS_SPREADSHEET_ID=
# AI_RESPONSES_SPREADSHEET_ID belongs to the satellite AI-Audit app, which owns
# both that sheet and the ai_audit_responses table in the shared database. This
# app stopped syncing it in v1.15.0. Set it in AI-Audit's .env, not here.
DATA_SHEET_ID=

# ---------------------------------------------------------------------------
# Seed credentials
# ---------------------------------------------------------------------------
# Used only by EnvAuthProvider and for initial seeding of the users table.
# Format is provider-specific — see auth.py. On a restore from backup the users
# table already exists and these are not needed.
USER_ADMIN=
USER_DLA=
USER_FACULTY=
# One per school as required, e.g. USER_EDUCATION=
